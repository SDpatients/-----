# ===========================================
# Docker Compose 环境变量配置文件
# ===========================================
# 项目名称
COMPOSE_PROJECT_NAME=supplier-collaboration

# ===========================================
# MySQL 配置
# ===========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=supplier_collaboration
MYSQL_USER=supplier
MYSQL_PASSWORD=supplier123456

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ===========================================
# MongoDB 配置
# ===========================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo123456
MONGO_DATABASE=supplier_collaboration

# ===========================================
# RabbitMQ 配置
# ===========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ===========================================
# Elasticsearch 配置
# ===========================================
ES_HOST=elasticsearch
ES_PORT=9200
ES_CLUSTER_NAME=supplier-cluster

# ===========================================
# MinIO 配置
# ===========================================
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ===========================================
# Nginx 配置 (生产环境)
# ===========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================
# 后端服务配置
# ===========================================
BACKEND_HOST=backend
BACKEND_PORT=8080

# ===========================================
# 时区配置
# ===========================================
TZ=Asia/Shanghai
